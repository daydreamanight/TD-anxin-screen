# Clocks, and bounds on the first stage of each clock-domain crossing.
create_clock -name clk_50m -period 20.000 -waveform {0.000 10.000} [get_ports {clk}]
derive_clocks

set_max_delay 40.000 -datapath_only -from [get_regs -regexp {^u_catalog/req_toggle$}] -to [get_regs -regexp {^u_catalog/req_meta$}]
set_max_delay 10.000 -datapath_only -from [get_regs -regexp {^u_catalog/ack_toggle$}] -to [get_regs -regexp {^u_catalog/ack_meta$}]
set_max_delay 10.000 -datapath_only -from [get_regs -regexp {^u_command/req_toggle$}] -to [get_regs -regexp {^u_command/req_meta$}]
set_max_delay 40.000 -datapath_only -from [get_regs -regexp {^u_command/ack_toggle$}] -to [get_regs -regexp {^u_command/ack_meta$}]
set_max_delay 40.000 -datapath_only -from [get_regs -regexp {^u_cfg_mailbox/req_toggle$}] -to [get_regs -regexp {^u_cfg_mailbox/req_meta$}]
set_max_delay 10.000 -datapath_only -from [get_regs -regexp {^u_cfg_mailbox/ack_toggle$}] -to [get_regs -regexp {^u_cfg_mailbox/ack_meta$}]
set_max_delay 10.000 -datapath_only -from [get_regs -regexp {^cfg_ready_pix$}] -to [get_regs -regexp {^cfg_applied_sd_meta$}]
set_max_delay 40.000 -datapath_only -from [get_regs -regexp {^u_response/payload\[[0-9]+\]$}] -to [get_regs -regexp {^u_response/dst_data\[[0-9]+\]$}]
set_max_delay 40.000 -datapath_only -from [get_regs -regexp {^u_response/req_toggle$}] -to [get_regs -regexp {^u_response/req_meta$}]
set_max_delay 10.000 -datapath_only -from [get_regs -regexp {^u_response/ack_toggle$}] -to [get_regs -regexp {^u_response/ack_meta$}]
set_max_delay 20.000 -datapath_only -from [get_regs -regexp {^u_sd_snapshot/payload\[[0-9]+\]$}] -to [get_regs -regexp {^u_sd_snapshot/dst_data\[[0-9]+\]$}]
set_max_delay 20.000 -datapath_only -from [get_regs -regexp {^u_sd_snapshot/req_toggle$}] -to [get_regs -regexp {^u_sd_snapshot/req_meta$}]
set_max_delay 10.000 -datapath_only -from [get_regs -regexp {^u_sd_snapshot/ack_toggle$}] -to [get_regs -regexp {^u_sd_snapshot/ack_meta$}]
set_max_delay 20.000 -datapath_only -from [get_regs -regexp {^u_pix_snapshot/payload\[[0-9]+\]$}] -to [get_regs -regexp {^u_pix_snapshot/dst_data\[[0-9]+\]$}]
set_max_delay 20.000 -datapath_only -from [get_regs -regexp {^u_pix_snapshot/req_toggle$}] -to [get_regs -regexp {^u_pix_snapshot/req_meta$}]
set_max_delay 40.000 -datapath_only -from [get_regs -regexp {^u_pix_snapshot/ack_toggle$}] -to [get_regs -regexp {^u_pix_snapshot/ack_meta$}]
set_max_delay 10.000 -datapath_only -from [get_regs -regexp {^u_framebuffer/u_write_fifo/wr_gray\[[0-9]+\]$}] -to [get_regs -regexp {^u_framebuffer/u_write_fifo/wr_gray_r1\[[0-9]+\]$}]
set_max_delay 10.000 -datapath_only -from [get_regs -regexp {^u_framebuffer/u_write_fifo/rd_gray\[[0-9]+\]$}] -to [get_regs -regexp {^u_framebuffer/u_write_fifo/rd_gray_w1\[[0-9]+\]$}]
set_max_delay 25.000 -datapath_only -from [get_regs -regexp {^u_framebuffer/u_read_fifo/wr_gray\[[0-9]+\]$}] -to [get_regs -regexp {^u_framebuffer/u_read_fifo/wr_gray_r1\[[0-9]+\]$}]
set_max_delay 25.000 -datapath_only -from [get_regs -regexp {^u_framebuffer/u_read_fifo/rd_gray\[[0-9]+\]$}] -to [get_regs -regexp {^u_framebuffer/u_read_fifo/rd_gray_w1\[[0-9]+\]$}]
set_max_delay 10.000 -datapath_only -from [get_regs -regexp {^u_framebuffer/load_req_sd$}] -to [get_regs -regexp {^u_framebuffer/load_req_m\[0\]$}]
set_max_delay 10.000 -datapath_only -from [get_regs -regexp {^u_framebuffer/abort_sd$}] -to [get_regs -regexp {^u_framebuffer/abort_m\[0\]$}]
set_max_delay 10.000 -datapath_only -from [get_regs -regexp {^u_framebuffer/load_bank_sd$}] -to [get_regs -regexp {^u_framebuffer/load_bank_m\[0\]$}]
set_max_delay 10.000 -datapath_only -from [get_regs -regexp {^u_framebuffer/decode_seen_sd$}] -to [get_regs -regexp {^u_framebuffer/decode_m\[0\]$}]
set_max_delay 10.000 -datapath_only -from [get_regs -regexp {^u_framebuffer/source_error_sd\[[0-9]+\]$}] -to [get_regs -regexp {^u_framebuffer/source_err_m1\[[0-9]+\]$}]
set_max_delay 25.000 -datapath_only -from [get_regs -regexp {^u_framebuffer/frame_req_pix$}] -to [get_regs -regexp {^u_framebuffer/frame_req_m\[0\]$}]
set_max_delay 25.000 -datapath_only -from [get_regs -regexp {^u_framebuffer/frame_bank_pix$}] -to [get_regs -regexp {^u_framebuffer/frame_bank_m\[0\]$}]
set_max_delay 25.000 -datapath_only -from [get_regs -regexp {^u_framebuffer/frame_enable_pix$}] -to [get_regs -regexp {^u_framebuffer/frame_enable_m\[0\]$}]
set_max_delay 10.000 -datapath_only -from [get_regs -regexp {^u_framebuffer/native_poison_mem$}] -to [get_regs -regexp {^u_framebuffer/native_poison_sd\[0\]$}]
set_max_delay 10.000 -datapath_only -from [get_regs -regexp {^u_framebuffer/load_seen_mem$}] -to [get_regs -regexp {^u_framebuffer/load_seen_sd\[0\]$}]
set_max_delay 10.000 -datapath_only -from [get_regs -regexp {^u_framebuffer/load_ack_mem$}] -to [get_regs -regexp {^u_framebuffer/load_ack_sd\[0\]$}]
set_max_delay 10.000 -datapath_only -from [get_regs -regexp {^u_framebuffer/result_toggle_mem$}] -to [get_regs -regexp {^u_framebuffer/result_sync_sd\[0\]$}]
set_max_delay 10.000 -datapath_only -from [get_regs -regexp {^u_framebuffer/load_fault_mem\[[0-9]+\]$}] -to [get_regs -regexp {^u_framebuffer/fault_s1\[[0-9]+\]$}]
set_max_delay 10.000 -datapath_only -from [get_regs -regexp {^u_framebuffer/result_code_mem\[[0-9]+\]$}] -to [get_regs -regexp {^u_framebuffer/result_code_s1\[[0-9]+\]$}]
set_max_delay 25.000 -datapath_only -from [get_regs -regexp {^u_framebuffer/frame_ack_mem$}] -to [get_regs -regexp {^u_framebuffer/frame_ack_pix\[0\]$}]
set_max_delay 25.000 -datapath_only -from [get_regs -regexp {^u_framebuffer/reader_error_mem\[[0-9]+\]$}] -to [get_regs -regexp {^u_framebuffer/reader_error_p1\[[0-9]+\]$}]

set_max_delay 40.000 -datapath_only -from [get_regs -regexp {^u_tone/O_i2s_BCLK$}] -to [get_regs -regexp {^u_audio_receiver/S_i2s_bclk_1d$}]
set_max_delay 40.000 -datapath_only -from [get_regs -regexp {^u_tone/O_i2s_LRCK$}] -to [get_regs -regexp {^u_audio_receiver/S_i2s_lrck_1d$}]
set_max_delay 40.000 -datapath_only -from [get_regs -regexp {^u_tone/O_i2s_DOUT$}] -to [get_regs -regexp {^u_audio_receiver/S_i2s_dout_1d$}]

set_max_delay 40.000 -datapath_only -from [get_regs -regexp {^u_control_link/u_request/req_toggle$}] -to [get_regs -regexp {^u_control_link/u_request/req_meta$}]
set_max_delay 20.000 -datapath_only -from [get_regs -regexp {^u_control_link/u_request/ack_toggle$}] -to [get_regs -regexp {^u_control_link/u_request/ack_meta$}]
set_max_delay 20.000 -datapath_only -from [get_regs -regexp {^u_control_link/u_return/req_toggle$}] -to [get_regs -regexp {^u_control_link/u_return/req_meta$}]
set_max_delay 40.000 -datapath_only -from [get_regs -regexp {^u_control_link/u_return/ack_toggle$}] -to [get_regs -regexp {^u_control_link/u_return/ack_meta$}]
set_false_path -from [get_ports {uart_rx}] -to [get_regs -regexp {^u_serial_rx/rx_meta$}]
